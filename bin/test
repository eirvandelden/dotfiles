#!/usr/bin/env ruby
# Runs test files in parallel, each as `ruby -Itest <file>` in its own process group, from the
# repository root. Without file arguments it runs every test/*_test.rb. `-j N` sets how many run at once.
# A file's output is printed as one block when it ends. The exit status is 1 when any file fails, 130
# on INT or TERM: each running file gets INT, and KILL when it still runs 5 seconds later.
# test/test_runner_test.rb covers this script.
require "etc"
require "optparse"
require "rbconfig"
require "tempfile"

class TestRun
  Job = Struct.new(:file, :pid, :output, :started)
  GRACE_SECONDS = 5

  def initialize(files, root:, jobs:)
    @files = files.dup
    @total = files.size
    @root = root
    @jobs = jobs
    @running = []
    @failed = []
  end

  def call
    trap("TERM") { raise Interrupt }
    start_next while @running.size < @jobs && @files.any?
    finish_one until @running.empty?
    summary
    @failed.empty? ? 0 : 1
  rescue Interrupt
    stop_all
    130
  end

  private

  # Each file has its own process group, so a Ctrl-C reaches only this runner. Pass it on, so
  # each file runs its own cleanup, and kill the groups still running after the grace period.
  def stop_all
    trap("INT", "IGNORE")
    @running.each { |job| signal_group("INT", job.pid) }
    deadline = monotonic_now + GRACE_SECONDS
    sleep(0.05) until @running.all? { |job| ended?(job) } || monotonic_now > deadline
    @running.each { |job| signal_group("KILL", job.pid) }
    @running.each { |job| reap(job) }
  end

  def ended?(job)
    Process.wait(job.pid, Process::WNOHANG) ? true : false
  rescue Errno::ECHILD
    true
  end

  def reap(job)
    Process.wait(job.pid)
  rescue Errno::ECHILD
    nil
  ensure
    job.output.close!
  end

  def signal_group(signal, pid)
    Process.kill(signal, -pid)
  rescue Errno::ESRCH, Errno::EPERM
    nil
  end

  def monotonic_now
    Process.clock_gettime(Process::CLOCK_MONOTONIC)
  end

  def start_next
    file = @files.shift
    output = Tempfile.new("test-run")
    pid = Process.spawn(RbConfig.ruby, "-Itest", file, chdir: @root, pgroup: true, in: File::NULL,
                        out: output.fileno, err: output.fileno)
    @running << Job.new(file, pid, output, monotonic_now)
  end

  def finish_one
    pid, status = Process.wait2
    job = @running.find { |candidate| candidate.pid == pid }
    @running.delete(job)
    report(job, status)
    start_next if @files.any?
  end

  def report(job, status)
    seconds = monotonic_now - job.started
    job.output.rewind
    puts("=== #{job.file} (#{seconds.round(1)}s) ===", job.output.read)
    job.output.close!
    @failed << job.file unless status.success?
  end

  def summary
    @failed.sort.each { |file| puts("FAILED: #{file}") }
    puts("#{@total} files, #{@failed.size} failed")
  end
end

jobs = Etc.nprocessors
OptionParser.new { |parser| parser.on("-j", "--jobs N", Integer) { |count| jobs = count } }.parse!
abort("bin/test: -j must be at least 1, got #{jobs}") if jobs < 1
root = File.expand_path("..", __dir__)
files = ARGV.empty? ? Dir.chdir(root) { Dir.glob("test/*_test.rb").sort } : ARGV.dup
exit(TestRun.new(files, root: root, jobs: jobs).call)
