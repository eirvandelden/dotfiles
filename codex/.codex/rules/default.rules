prefix_rule(pattern=["/opt/homebrew/bin/zsh", "-lc", "rm -f /private/tmp/caren-pulls-all.json && : > /private/tmp/caren-prs-2025.jsonl && for page in {1..40}; do gh api \"repos/nedap/caren3/pulls?state=all&sort=created&direction=desc&per_page=100&page=$page\" --jq '.[] | select(.created_at >= \"2025-01-01T00:00:00Z\") | {number, state, created_at, closed_at, merged_at, title, draft, additions, deletions, changed_files, labels: [.labels[].name], author: .user.login, base: .base.ref}' >> /private/tmp/caren-prs-2025.jsonl; done && jq -s '{count:length, open:(map(select(.state == \"open\")) | length), closed:(map(select(.state == \"closed\")) | length), merged:(map(select(.merged_at != null)) | length), earliest:(map(.created_at) | min), latest:(map(.created_at) | max), lowest_number:(map(.number) | min), highest_number:(map(.number) | max), total_additions:(map(.additions) | add), total_deletions:(map(.deletions) | add), sizes:(group_by(if .changed_files == 0 then \"0\" elif .changed_files <= 5 then \"1-5\" elif .changed_files <= 20 then \"6-20\" else \"21+\" end) | map({files: (if .[0].changed_files == 0 then \"0\" elif .[0].changed_files <= 5 then \"1-5\" elif .[0].changed_files <= 20 then \"6-20\" else \"21+\" end), count:length}))}' /private/tmp/caren-prs-2025.jsonl"], decision="allow")
