# Codex appends `allow` rules here on approval; review this file in every commit that touches
# `codex/`; the parity test (test/guard_parity_test.rb) rejects guarded patterns and machine paths.
#
# Prompt before a handful of destructive or infra-affecting commands, so Codex
# stays autonomous (approval_policy = "on-request") for everything else.
# Reference: https://github.com/openai/codex/tree/main/codex-rs/execpolicy

prefix_rule(
    pattern = ["rm"],
    decision = "prompt",
    justification = "deletes files with no undo",
    match = [["rm", "file.txt"], "rm -rf build"],
)

prefix_rule(
    pattern = ["trash"],
    decision = "prompt",
    justification = "removes files, even if recoverable from the system trash",
    match = [["trash", "file.txt"]],
)

prefix_rule(
    pattern = ["kamal", "deploy"],
    decision = "prompt",
    justification = "deploys to production (playbook rule 13)",
    match = [["kamal", "deploy"]],
)

prefix_rule(
    pattern = ["cap", "deploy"],
    decision = "prompt",
    justification = "deploys to production (playbook rule 13)",
    match = [["cap", "deploy"]],
)

prefix_rule(
    pattern = ["terraform", "destroy"],
    decision = "prompt",
    justification = "destroys provisioned infrastructure",
    match = [["terraform", "destroy"]],
)

prefix_rule(
    pattern = ["terraform", "apply"],
    decision = "prompt",
    justification = "changes provisioned infrastructure",
    match = [["terraform", "apply"]],
)

prefix_rule(
    pattern = ["kubectl", "delete"],
    decision = "prompt",
    justification = "deletes cluster resources",
    match = [["kubectl", "delete", "pod", "foo"]],
)

prefix_rule(
    pattern = ["docker", "system", "prune"],
    decision = "prompt",
    justification = "deletes unused containers, images, and volumes",
    match = [["docker", "system", "prune"]],
)

# A second layer under the consent guard hook (claude/.claude/hooks/consent-guard.rb, wired
# in config.toml's [hooks]). The hook is what refuses; these rules make Codex ask, or refuse,
# for plain --force, --no-verify, posting on GitHub and deploys even if the hook cannot run.
# The hook's remote check (pushes only to your own repositories) has no rule equivalent, so
# the push allows below name `origin` only; any other remote prompts.

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "plain --force overwrites remote history; use --force-with-lease (playbook rule 20)",
    match = [["git", "push", "--force", "origin", "x"]],
    not_match = [["git", "push", "--force-with-lease", "origin", "x"]],
)

prefix_rule(
    pattern = ["git", "push", "--no-verify"],
    decision = "prompt",
    justification = "skips the git hooks that keep commits off main",
    match = [["git", "push", "--no-verify", "origin", "x"]],
)

prefix_rule(
    pattern = ["git", "commit", "--no-verify"],
    decision = "prompt",
    justification = "skips the git hooks that keep commits off main",
    match = [["git", "commit", "--no-verify", "-m", "x"]],
)

prefix_rule(
    pattern = ["gh", "pr", "comment"],
    decision = "prompt",
    justification = "posts on GitHub as the user (playbook rule 6)",
    match = [["gh", "pr", "comment", "12"]],
)

prefix_rule(
    pattern = ["gh", "pr", "review"],
    decision = "prompt",
    justification = "posts on GitHub as the user (playbook rule 6)",
    match = [["gh", "pr", "review", "12", "--approve"]],
)

prefix_rule(
    pattern = ["gh", "issue", "comment"],
    decision = "prompt",
    justification = "posts on GitHub as the user (playbook rule 6)",
    match = [["gh", "issue", "comment", "3"]],
)

prefix_rule(
    pattern = ["kamal", "app", "exec"],
    decision = "prompt",
    justification = "runs a command on production (playbook rule 13)",
    match = [["kamal", "app", "exec", "rails console"]],
)

# Below this line: a short vetted list of generic, routine commands. Codex appends more
# "always allow" rules here itself (codex-rs/core/src/exec_policy.rs,
# blocking_append_allow_prefix_rule) on every such approval. The prompt and forbidden rules
# above still win on any overlap: execpolicy applies the most restrictive matching decision.

prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["git", "diff", "--cached"], decision="allow")
prefix_rule(pattern=["git", "diff", "--check"], decision="allow")
prefix_rule(pattern=["git", "fetch", "origin", "main"], decision="allow")
prefix_rule(pattern=["git", "log", "--oneline"], decision="allow")
prefix_rule(pattern=["git", "push", "origin"], decision="allow")
prefix_rule(pattern=["git", "push", "-u", "origin"], decision="allow")
prefix_rule(pattern=["git", "rebase", "origin/main"], decision="allow")
prefix_rule(pattern=["git", "rev-parse", "HEAD"], decision="allow")
prefix_rule(pattern=["git", "status", "--short"], decision="allow")
prefix_rule(pattern=["git", "worktree", "add"], decision="allow")
prefix_rule(pattern=["git", "worktree", "remove"], decision="allow")
prefix_rule(pattern=["gh", "auth", "status"], decision="allow")
prefix_rule(pattern=["gh", "pr", "create"], decision="allow")
prefix_rule(pattern=["gh", "pr", "edit"], decision="allow")
prefix_rule(pattern=["gh", "pr", "view"], decision="allow")
prefix_rule(pattern=["bundle", "exec", "bundler-audit", "check", "--update"], decision="allow")
prefix_rule(pattern=["bundle", "install"], decision="allow")
prefix_rule(pattern=["bundle", "show"], decision="allow")
prefix_rule(pattern=["rails", "test"], decision="allow")
prefix_rule(pattern=["herdr", "agent", "list"], decision="allow")
prefix_rule(pattern=["herdr", "agent", "prompt"], decision="allow")
prefix_rule(pattern=["herdr", "agent", "start"], decision="allow")
prefix_rule(pattern=["herdr", "pane", "capture"], decision="allow")
prefix_rule(pattern=["herdr", "pane", "list"], decision="allow")
prefix_rule(pattern=["herdr", "pane", "read"], decision="allow")
prefix_rule(pattern=["herdr", "pane", "send-keys"], decision="allow")
prefix_rule(pattern=["herdr", "pane", "split"], decision="allow")
prefix_rule(pattern=["herdr", "worktree", "create"], decision="allow")
prefix_rule(pattern=["mkdir", "-p"], decision="allow")
prefix_rule(pattern=["curl", "--silent", "--show-error", "--location"], decision="allow")
prefix_rule(pattern = ["adb", "devices"], decision = "allow", justification = "lists attached Android devices; read-only", match = [["adb", "devices"]])
prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["rubocop", "--force-exclusion"], decision="allow")
prefix_rule(pattern=["git", "push", "-u", "origin", "HEAD"], decision="allow")
prefix_rule(pattern=["git", "rebase"], decision="allow")
prefix_rule(pattern=["claude", "-p", "--model", "opus", "--permission-mode", "plan"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="allow")
