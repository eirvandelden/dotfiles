[user]
  signingkey = ~/.local/state/agent-git/signing_key
[gpg]
  format = ssh
[gpg "ssh"]
  program = ~/Developer/dotfiles/git/.config/git/agent/ssh-sign
[commit]
  gpgsign = true
[url "https://github.com/eirvandelden/"]
  insteadOf = git@github.com:eirvandelden/
  insteadOf = ssh://git@github.com/eirvandelden/
[url "https://github.com/eirvandelden-dev/"]
  insteadOf = git@github.com:eirvandelden-dev/
  insteadOf = ssh://git@github.com/eirvandelden-dev/
[credential "https://github.com"]
  helper =
  helper = "!~/Developer/dotfiles/git/.config/git/agent/credential-keychain"
[credential "https://github.com/eirvandelden/"]
  helper =
  helper = "!~/Developer/dotfiles/git/.config/git/agent/credential-keychain eirvandelden"
[credential "https://github.com/eirvandelden-dev/"]
  helper =
  helper = "!~/Developer/dotfiles/git/.config/git/agent/credential-keychain eirvandelden-dev"
[hook "agent-origin-check"]
  event = pre-commit
  event = pre-push
  command = ~/Developer/dotfiles/git/.config/git/agent/origin-check
[hook "agent-no-private-keys"]
  event = pre-commit
  command = ~/Developer/dotfiles/git/.config/git/agent/no-private-keys
[hook "agent-co-authored-by"]
  event = commit-msg
  command = ~/Developer/dotfiles/git/.config/git/agent/co-authored-by
