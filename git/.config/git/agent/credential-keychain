#!/bin/sh
# Agent credential helper: arguments are [<owner>] <action>, as git appends the action.
# get answers with the agent token of <owner> from the login Keychain (service agent-git-github,
# account = owner). A missing item or an owner-less call quits git, so no other source asks.
# erase names a rejected token and never deletes the item. The token goes to stdout only.

readme="$HOME/Developer/dotfiles/git/.config/git/agent/README.md"

if [ "$#" -ge 2 ]; then
  owner=$1
  action=$2
else
  owner=""
  action=$1
fi

case "$action" in
  get)
    if [ -z "$owner" ]; then
      echo "agent-git: no agent token for this GitHub owner; agents push only to eirvandelden and eirvandelden-dev." >&2
      echo quit=1
      exit 0
    fi
    if token=$(security find-generic-password -s agent-git-github -a "$owner" -w 2>/dev/null); then
      echo username=x-access-token
      echo "password=$token"
    else
      echo "agent-git: no agent token for $owner in the login Keychain (service agent-git-github). See $readme." >&2
      echo quit=1
    fi
    ;;
  erase)
    echo "agent-git: GitHub rejected the agent token for ${owner:-this owner} (service agent-git-github); it is expired or revoked. Renew it: see $readme." >&2
    ;;
esac

exit 0
