# Private extension: another repository may add its own gate here. Git ignores a missing file.
[include]
  path = ~/.config/git/work-agent/claude.config
[includeIf "hasconfig:remote.*.url:git@github.com:eirvandelden/**"]
  path = claude-identity.config
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/eirvandelden/**"]
  path = claude-identity.config
[includeIf "hasconfig:remote.*.url:https://github.com/eirvandelden/**"]
  path = claude-identity.config
[includeIf "hasconfig:remote.*.url:git@github.com:eirvandelden-dev/**"]
  path = claude-identity.config
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/eirvandelden-dev/**"]
  path = claude-identity.config
[includeIf "hasconfig:remote.*.url:https://github.com/eirvandelden-dev/**"]
  path = claude-identity.config
