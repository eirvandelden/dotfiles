#!/bin/sh
# Git credential helper: answers git's "get" with the GitHub token from 1Password.
# Git names it by path in git/.config/git/config, so no program on PATH can replace it.
# When op read fails, quit=1 stops git, so no other source supplies a password.

[ "$1" = get ] || exit 0

token=$(op read op://Familie/Github/token --account vandelden) || {
  echo quit=1
  exit 0
}

echo username=x-access-token
echo "password=$token"
