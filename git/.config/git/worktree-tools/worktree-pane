#!/usr/bin/env ruby
# open/close/label the herdr pane rooted in a worktree's directory.
# In a herdr-app terminal herdr-app-pane does the work: open --worktree, close-at; label does nothing.
# Plain ruby, not rv: CI has no rv, and hand-off-plan.sh invokes this script directly.
$LOAD_PATH.unshift(File.expand_path("lib", __dir__))

require "common"
require "json"
require "open3"
require "rbconfig"

module WorktreeTools
  class Pane
    include Helpers

    #: (Array[String] argv) -> void
    def self.run!(argv)
      new.run!(argv)
    end

    USAGE = "Usage: worktree-pane open|close <path> | label <path> <pane-id>"
    COMMANDS = %w[open close label].freeze

    #: (Array[String] argv) -> void
    def run!(argv)
      return herdr_app(argv) if herdr_app_env?

      exec(RbConfig.ruby, File.join(__dir__, "worktree-pane-rex"), *argv) if rex_only_env?
      return unless herdr_env?

      command, target, pane_id = checked(argv)
      case command
      when "open" then open(target)
      when "close" then close(target)
      when "label" then label(target, pane_id)
      end
    end

    private

    # herdr-app has no pane rename, so label does nothing.
    def herdr_app(argv)
      command, target, = checked(argv)
      return if command == "label"

      exec(herdr_app_pane_bin, *(command == "open" ? [ "open", target, "--worktree" ] : [ "close-at", target ]))
    rescue SystemCallError => error
      die("worktree-pane: #{herdr_app_pane_bin} could not start (#{error.message})")
    end

    # Dies on bad arguments; answers the command, the real path of the worktree and the pane id.
    def checked(argv)
      command, path, pane_id = argv
      die(USAGE) if !COMMANDS.include?(command) || path.to_s.empty? ||
                    (command == "label" && pane_id.to_s.empty?)

      target = realpath!(path)
      die("worktree-pane: not inside a git repository: #{target}") unless git_common_dir(target)

      [ command, target, pane_id ]
    end

    def realpath!(path)
      File.realpath(path)
    rescue Errno::ENOENT
      die("worktree-pane: no such path: #{path}")
    end

    def herdr_env?
      ENV["HERDR_ENV"] == "1" && command_exists?("herdr")
    end

    def open(target)
      return if panes_at(target).any?

      pane_id = split(target)
      rename(pane_id, target) if pane_id
    end

    def close(target)
      panes_at(target).each { |pane| close_pane(pane) }
    end

    def label(target, pane_id)
      rename(pane_id, target)
    end

    def close_pane(pane)
      return warn("worktree-pane: leaving pane #{pane['pane_id']} open (agent running)") if has_agent?(pane)

      herdr("pane", "close", pane["pane_id"])
    end

    def has_agent?(pane)
      !pane["agent"].nil?
    end

    def panes_at(target)
      output, _error, status = herdr(*pane_list_arguments)
      return [] unless status.success?

      JSON.parse(output).dig("result", "panes").to_a.select { |pane| pane["cwd"] == target }
    rescue JSON::ParserError
      []
    end

    # HERDR_WORKSPACE_ID unset (herdr didn't put it in the pane's environment) falls back to no
    # filter — every workspace's panes are considered, rather than matching none.
    def pane_list_arguments
      workspace = ENV["HERDR_WORKSPACE_ID"]
      workspace.to_s.empty? ? [ "pane", "list" ] : [ "pane", "list", "--workspace", workspace ]
    end

    def split(target)
      output, error, status = herdr("pane", "split", "--current", "--direction", "down", "--cwd", target,
                                     "--no-focus")
      return warn_refused(error) unless status.success?

      JSON.parse(output).dig("result", "pane", "pane_id")
    rescue JSON::ParserError
      warn_refused("herdr returned unparsable output")
    end

    def warn_refused(error)
      warn("worktree-pane: herdr refused to split a pane for this worktree (#{error.to_s.strip})")
      nil
    end

    def rename(pane_id, target)
      herdr("pane", "rename", pane_id, label_for(target))
    end

    def label_for(target)
      repo = git_common_dir(target).dirname.basename.to_s
      branch, = Open3.capture2("git", "-C", target, "rev-parse", "--abbrev-ref", "HEAD")
      "#{repo}/#{branch.strip}"
    end

    def herdr(*arguments)
      Open3.capture3("herdr", *arguments)
    end
  end
end

WorktreeTools::Pane.run!(ARGV) if $PROGRAM_NAME == __FILE__
