#!/usr/bin/env ruby
# open/close the herdr-app terminal rooted in a worktree's directory.
# In a herdr-app terminal herdr-app-pane does the work: open --worktree, close-at. Elsewhere it does nothing.
# Plain ruby, not rv: CI has no rv, and hand-off-plan.sh invokes this script directly.
$LOAD_PATH.unshift(File.expand_path("lib", __dir__))

require "common"

module WorktreeTools
  class Pane
    include Helpers

    #: (Array[String] argv) -> void
    def self.run!(argv)
      new.run!(argv)
    end

    USAGE = "Usage: worktree-pane open|close <path>"
    COMMANDS = %w[open close].freeze

    #: (Array[String] argv) -> void
    def run!(argv)
      herdr_app(argv) if herdr_app_env?
    end

    private

    def herdr_app(argv)
      command, target = checked(argv)

      exec(herdr_app_pane_bin, *(command == "open" ? [ "open", target, "--worktree" ] : [ "close-at", target ]))
    rescue SystemCallError => error
      die("worktree-pane: #{herdr_app_pane_bin} could not start (#{error.message})")
    end

    # Dies on bad arguments; answers the command and the real path of the worktree.
    def checked(argv)
      command, path = argv
      die(USAGE) if !COMMANDS.include?(command) || path.to_s.empty?

      target = realpath!(path)
      die("worktree-pane: not inside a git repository: #{target}") unless git_common_dir(target)

      [ command, target ]
    end

    def realpath!(path)
      File.realpath(path)
    rescue Errno::ENOENT
      die("worktree-pane: no such path: #{path}")
    end
  end
end

WorktreeTools::Pane.run!(ARGV) if $PROGRAM_NAME == __FILE__
