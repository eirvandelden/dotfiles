#!/usr/bin/env rv run ruby
# open/close/label the herdr pane rooted in a worktree's directory.
$LOAD_PATH.unshift(File.expand_path("lib", __dir__))

require "common"
require "json"
require "open3"

module WorktreeTools
  class Pane
    include Helpers

    def self.run!(argv)
      new.run!(argv)
    end

    def run!(argv)
      command, path, pane_id = argv
      return unless herdr_env?

      case command
      when "open" then open(File.realpath(path))
      when "close" then close(File.realpath(path))
      when "label" then label(File.realpath(path), pane_id)
      else die("Usage: worktree-pane open|close <path> | label <path> <pane-id>")
      end
    end

    private

    def herdr_env?
      ENV["HERDR_ENV"] == "1" && command_exists?("herdr")
    end

    def open(target)
      return if panes_at(target).any?

      pane_id = split(target)
      rename(pane_id, target) if pane_id
    end

    def close(target)
      panes_at(target).each { |pane| close_pane(pane) }
    end

    def label(target, pane_id)
      rename(pane_id, target)
    end

    def close_pane(pane)
      return warn("worktree-pane: leaving pane #{pane['pane_id']} open (agent running)") if running?(pane)

      herdr("pane", "close", pane["pane_id"])
    end

    def running?(pane)
      ![ nil, "idle", "unknown" ].include?(pane["agent_status"])
    end

    def panes_at(target)
      output, _error, status = herdr(*pane_list_arguments)
      return [] unless status.success?

      JSON.parse(output).dig("result", "panes").to_a.select { |pane| pane["cwd"] == target }
    rescue JSON::ParserError
      []
    end

    # HERDR_WORKSPACE_ID unset (herdr didn't put it in the pane's environment) falls back to no
    # filter — every workspace's panes are considered, rather than matching none.
    def pane_list_arguments
      workspace = ENV["HERDR_WORKSPACE_ID"]
      workspace.to_s.empty? ? [ "pane", "list" ] : [ "pane", "list", "--workspace", workspace ]
    end

    def split(target)
      output, error, status = herdr("pane", "split", "--current", "--direction", "down", "--cwd", target,
                                     "--no-focus")
      return warn_refused(error) unless status.success?

      JSON.parse(output).dig("result", "pane", "pane_id")
    rescue JSON::ParserError
      warn_refused("herdr returned unparsable output")
    end

    def warn_refused(error)
      warn("worktree-pane: herdr refused to split a pane for this worktree (#{error.to_s.strip})")
      nil
    end

    def rename(pane_id, target)
      herdr("pane", "rename", pane_id, label_for(target))
    end

    def label_for(target)
      repo = git_common_dir(target).dirname.basename.to_s
      branch, = Open3.capture2("git", "-C", target, "rev-parse", "--abbrev-ref", "HEAD")
      "#{repo}/#{branch.strip}"
    end

    def herdr(*arguments)
      Open3.capture3("herdr", *arguments)
    end
  end
end

WorktreeTools::Pane.run!(ARGV) if $PROGRAM_NAME == __FILE__
