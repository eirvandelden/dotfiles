#!/usr/bin/env ruby
# Pre-push backstop: refuses a push whose change folder has no review.md at least as new,
# in commits, as the last change to anything outside the folder. Freshness is defined in git
# terms, not mtime — see docs/changes/ai-native-workflow/spec.md §4. Exits 0 when there is nothing to enforce yet (no change
# folder in HEAD, or the branch has no code commits of its own) or when the review is fresh;
# exits 1 with a message otherwise.
#
# With --skip-without-pr (the pre-push hook passes it) a change folder in HEAD also passes while
# the branch has no open pull request, so a work-in-progress push needs no review yet. Once a PR
# is open, or when gh cannot tell, the strict check applies. Without the flag the script stays
# strict: finish runs it that way before it opens the PR. An older copy of this script ignores
# the flag and stays strict.
#
# "Last change to anything outside the folder" is scoped to this branch's own commits — the
# range past the merge-base with the base branch — so main's history before the branch point
# never counts as code the branch itself introduced.
require "open3"
require "time"

CHANGE_FOLDER_SCRIPT = File.expand_path("../../../../claude/.claude/skills/plan/scripts/change-folder", __dir__)

def capture(*command)
  stdout, status = Open3.capture2(*command)
  raise "#{command.join(' ')} failed" unless status.success?

  stdout
end

def folder
  stdout, status = Open3.capture2(CHANGE_FOLDER_SCRIPT)
  exit(0) unless status.success?

  stdout.strip
end

def folder_in_head?(folder)
  _, status = Open3.capture2("git", "cat-file", "-e", "HEAD:#{folder}")
  status.success?
end

def no_open_pull_request?
  branch = capture("git", "rev-parse", "--abbrev-ref", "HEAD").strip
  count, _stderr, status = Open3.capture3("gh", "pr", "list", "--head", branch, "--state", "open",
                                          *origin_repository, "--json", "number", "--jq", "length")
  return count.strip == "0" if status.success?

  warn("gh could not tell whether #{branch} has an open pull request: applying the strict check.")
  false
rescue SystemCallError
  warn("gh could not tell whether the branch has an open pull request: applying the strict check.")
  false
end

# gh picks the repository itself, and with an `upstream` remote that is not origin. Pin it to origin.
def origin_repository
  url, _stderr, status = Open3.capture3("git", "remote", "get-url", "origin")
  path = url[%r{github\.com[:/](?<path>[^/\s]+/[^/\s]+?)(?:\.git)?\s*\z}, :path] if status.success?
  path ? [ "--repo", path ] : []
end

def latest_commit(pathspec, range: nil)
  format = "%H\x1f%s\x1f%cI"
  command = [ "git", "log", "-1", "--format=#{format}" ]
  command << range if range
  command += [ "--", *pathspec ]
  stdout = capture(*command)
  return nil if stdout.strip.empty?

  sha, subject, date = stdout.strip.split("\x1f")
  { sha: sha, subject: subject, date: Time.iso8601(date).strftime("%Y-%m-%d") }
end

def resolved_base_branch
  stdout, _stderr, status = Open3.capture3("git", "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
  candidate = stdout.strip if status.success?
  return candidate if candidate && ref_exists?(candidate)

  %w[main master].find { |name| local_branch?(name) }
end

def ref_exists?(ref)
  _, _stderr, status = Open3.capture3("git", "rev-parse", "--verify", "--quiet", ref)
  status.success?
end

def local_branch?(name)
  ref_exists?("refs/heads/#{name}")
end

def own_commit_range(base_branch)
  return nil if base_branch.nil?

  stdout, _stderr, status = Open3.capture3("git", "merge-base", base_branch, "HEAD")
  return nil unless status.success?

  "#{stdout.strip}..HEAD"
end

def code_commit(folder, range)
  latest_commit([ ".", ":(exclude,glob)#{folder}/**" ], range: range)
end

def review_commit(folder)
  latest_commit([ "#{folder}/review.md" ])
end

def review_covers_code?(code, review)
  return true if code.nil?
  return false if review.nil?

  code[:sha] == review[:sha] ||
    system("git", "merge-base", "--is-ancestor", code[:sha], review[:sha])
end

def uncommitted_paths_outside(folder)
  capture("git", "status", "--porcelain", "--untracked-files=all").lines.filter_map do |line|
    path = line[3..].strip.delete_prefix('"').delete_suffix('"')
    path unless path.start_with?("#{folder}/")
  end
end

def describe(commit, label)
  return "no #{label}" if commit.nil?

  "#{label}: \"#{commit[:subject]}\" (#{commit[:date]})"
end

def refuse(folder, code, review, dirty_paths)
  lines = [ "Change folder #{folder} is not covered by a fresh review." ]
  lines << describe(code, "last code commit")
  lines << describe(review, "review.md")
  unless dirty_paths.empty?
    lines << "Uncommitted, outside the change folder: #{dirty_paths.join(', ')}"
  end
  lines << "Run /review, then push again."

  warn(lines.join("\n"))
  exit(1)
end

slug_folder = folder
exit(0) unless folder_in_head?(slug_folder)
exit(0) if ARGV.include?("--skip-without-pr") && no_open_pull_request?

code = code_commit(slug_folder, own_commit_range(resolved_base_branch))
review = review_commit(slug_folder)
dirty_paths = uncommitted_paths_outside(slug_folder)

exit(0) if review_covers_code?(code, review) && dirty_paths.empty?

refuse(slug_folder, code, review, dirty_paths)
