#!/usr/bin/env ruby
# Sweep merged/gone worktrees, then create a fresh one off origin's default branch.
# Plain ruby, not rv: CI has no rv, and hand-off-plan.sh invokes this script directly.
$LOAD_PATH.unshift(File.expand_path("lib", __dir__))

require "agent_worktree"
require "common"
require "json"
require "repository"
require "sweep"
require "open3"
require "rbconfig"

module WorktreeTools
  class Create
    include Helpers

    PANE = File.expand_path("worktree-pane", __dir__)

    def self.run!(argv)
      new.run!(argv)
    end

    def run!(argv)
      no_pane = !argv.delete("--no-pane").nil?
      name = argv.shift
      die("worktree-create: a branch name is required") if name.to_s.empty?

      repository = Repository.new("worktree-create")
      Dir.chdir(repository.root)
      die("worktree-create: .worktrees is not gitignored; add it to .git/info/exclude") unless worktrees_ignored?
      git("worktree", "prune")

      path = repository.exclusively { prepare_worktree(repository, name) }
      open_pane(path) unless no_pane
      puts path
    end

    private

    def prepare_worktree(repository, name)
      default_branch = repository.default_branch
      repository.fetch_default_branch(default_branch)
      Sweep.new("worktree-create").run(default_branch: default_branch, keep: kept_paths(name))
      path = create_worktree(name, default_branch)
      record_for_herdr_pane(path)
      run_worktree_init(path)
      path
    end

    def kept_paths(name)
      path = ".worktrees/#{name}"
      File.directory?(path) ? [ path ] : []
    end

    def worktrees_ignored?
      _, status = git("check-ignore", "-q", ".worktrees")
      status.success?
    end

    def create_worktree(name, default_branch)
      path = File.expand_path(".worktrees/#{name}")
      return reuse_worktree(path) if worktree_on_branch?(path, name)

      _output, error, status = Open3.capture3("git", "worktree", "add", ".worktrees/#{name}", "-b", name,
                                               "origin/#{default_branch}")
      die("worktree-create: git worktree add failed: #{error.strip}") unless status.success?

      path
    end

    def worktree_on_branch?(path, name)
      return false unless File.directory?(path)

      output, status = git("-C", path, "rev-parse", "--abbrev-ref", "HEAD")
      status.success? && output.strip == name
    end

    def reuse_worktree(path)
      warn("worktree-create: reusing existing worktree")
      path
    end

    def record_for_herdr_pane(path)
      pane_id = ENV["HERDR_PANE_ID"].to_s
      return if pane_id.empty?

      terminal_id = terminal_id_of(pane_id)
      AgentWorktree.new.record(pane_id, terminal_id, path) if terminal_id
    rescue SystemCallError => error
      warn("worktree-create: could not record the worktree for pane #{pane_id} (#{error.message})")
    end

    def terminal_id_of(pane_id)
      output, status = Open3.capture2(herdr_bin, "pane", "get", pane_id, err: File::NULL)
      JSON.parse(output).dig("result", "pane", "terminal_id") if status.success?
    rescue Errno::ENOENT, JSON::ParserError
      nil
    end

    def run_worktree_init(path)
      _, status = git("-C", path, "config", "--get", "alias.worktree-init")
      Open3.capture2("git", "worktree-init", chdir: path) if status.success?
    end

    def open_pane(path)
      Open3.capture2(RbConfig.ruby, PANE, "open", path)
    end

    def git(*arguments)
      Open3.capture2("git", *arguments, err: File::NULL)
    end
  end
end

WorktreeTools::Create.run!(ARGV) if $PROGRAM_NAME == __FILE__
