#!/usr/bin/env rv run ruby
# Sweep merged/gone worktrees, then create a fresh one off origin's default branch.
$LOAD_PATH.unshift(File.expand_path("lib", __dir__))

require "common"
require "open3"
require "rbconfig"

module WorktreeTools
  class Create
    include Helpers

    PANE = File.expand_path("worktree-pane", __dir__)
    REMOVE = File.expand_path("worktree-remove", __dir__)

    def self.run!(argv)
      new.run!(argv)
    end

    def run!(argv)
      name = argv.shift
      no_pane = !argv.delete("--no-pane").nil?
      die("worktree-create: a branch name is required") if name.to_s.empty?
      die("worktree-create: .worktrees is not gitignored; add it to .git/info/exclude") unless worktrees_ignored?

      default_branch = default_branch!
      fetch(default_branch)
      sweep(default_branch)
      path = create_worktree(name, default_branch)
      run_worktree_init(path)
      open_pane(path) unless no_pane
      puts path
    end

    private

    def worktrees_ignored?
      _, status = git("check-ignore", "-q", ".worktrees")
      status.success?
    end

    def default_branch!
      branch = symbolic_ref_default_branch || remote_show_default_branch
      die("worktree-create: cannot determine default branch") if branch.to_s.empty? || branch == "(unknown)"
      branch
    end

    def symbolic_ref_default_branch
      output, status = git("symbolic-ref", "--short", "refs/remotes/origin/HEAD")
      output.strip.delete_prefix("origin/") if status.success?
    end

    def remote_show_default_branch
      output, = git("remote", "show", "origin")
      output.lines.find { |line| line.include?("HEAD branch:") }&.split(":")&.last&.strip
    end

    def fetch(branch)
      git("fetch", "origin", branch)
    end

    def sweep(default_branch)
      Dir.glob(".worktrees/*/").each { |dir| sweep_one(dir.chomp("/"), default_branch) }
    end

    def sweep_one(dir, default_branch)
      return unless clean?(dir)

      branch = worktree_branch(dir)
      state = pr_state(branch)
      return if fresh?(branch, state, default_branch)

      remove_worktree(dir, branch, state) if state == "MERGED" || ancestor?(branch, default_branch)
    end

    def clean?(dir)
      output, = git("-C", dir, "status", "--porcelain")
      output.strip.empty?
    end

    def worktree_branch(dir)
      output, = git("-C", dir, "rev-parse", "--abbrev-ref", "HEAD")
      output.strip
    end

    def pr_state(branch)
      output, status = Open3.capture2("gh", "pr", "view", branch, "--json", "state", "-q", ".state",
                                       err: File::NULL)
      output.strip if status.success?
    end

    def fresh?(branch, state, default_branch)
      return false unless state.to_s.empty?

      branch_sha(branch) == branch_sha("origin/#{default_branch}")
    end

    def branch_sha(ref)
      output, = git("rev-parse", ref)
      output.strip
    end

    def ancestor?(branch, default_branch)
      _, status = git("merge-base", "--is-ancestor", branch, "origin/#{default_branch}")
      status.success?
    end

    def remove_worktree(dir, branch, state)
      close_pane(dir)
      run_worktree_remove(dir)
      git("worktree", "remove", dir)
      git("branch", state == "MERGED" ? "-D" : "-d", branch)
    end

    def close_pane(dir)
      Open3.capture2(RbConfig.ruby, PANE, "close", dir)
    end

    def run_worktree_remove(dir)
      return unless File.executable?(REMOVE)

      Open3.capture2(RbConfig.ruby, REMOVE, dir)
    end

    def create_worktree(name, default_branch)
      git("worktree", "add", ".worktrees/#{name}", "-b", name, "origin/#{default_branch}")
      File.expand_path(".worktrees/#{name}")
    end

    def run_worktree_init(path)
      _, status = git("-C", path, "config", "--get", "alias.worktree-init")
      Open3.capture2("git", "worktree-init", chdir: path) if status.success?
    end

    def open_pane(path)
      Open3.capture2(RbConfig.ruby, PANE, "open", path)
    end

    def git(*arguments)
      Open3.capture2("git", *arguments, err: File::NULL)
    end
  end
end

WorktreeTools::Create.run!(ARGV) if $PROGRAM_NAME == __FILE__
