#!/bin/sh
# Runs one git hook through lefthook: lefthook-wrapper HOOK [ARG...]. Every hook script in this
# directory hands its name and arguments to this file.
#
# In a personal repository (origin owned by eirvandelden) it writes a temporary config that extends
# the shared lefthook.yml and then the repo's own config, so the repo's jobs win. Any other
# repository runs only its own config. GIT_DIR is unset: git exports it to hooks, and a job that
# runs `bundle exec` or git in another repository breaks under it.

hook="$1"
shift

if [ "$LEFTHOOK_VERBOSE" = "1" ] || [ "$LEFTHOOK_VERBOSE" = "true" ]; then
  set -x
fi

if [ "$LEFTHOOK" = "0" ]; then
  exit 0
fi

shared_config="$HOME/Developer/dotfiles/lefthook.yml"

call_lefthook()
{
  if test -n "$LEFTHOOK_BIN"
  then
    "$LEFTHOOK_BIN" "$@"
  elif lefthook -h >/dev/null 2>&1
  then
    lefthook "$@"
  elif /Users/etienne.vandelden/.local/share/rv/rubies/ruby-4.0.5/lib/ruby/gems/4.0.0/gems/lefthook-2.1.10/libexec/lefthook-darwin-arm64/lefthook -h >/dev/null 2>&1
  then
    /Users/etienne.vandelden/.local/share/rv/rubies/ruby-4.0.5/lib/ruby/gems/4.0.0/gems/lefthook-2.1.10/libexec/lefthook-darwin-arm64/lefthook "$@"
  else
    dir="$(git rev-parse --show-toplevel)"
    osArch=$(uname | tr '[:upper:]' '[:lower:]')
    cpuArch=$(uname -m | sed 's/aarch64/arm64/;s/x86_64/x64/')
    if test -f "$dir/node_modules/lefthook-${osArch}-${cpuArch}/bin/lefthook"
    then
      "$dir/node_modules/lefthook-${osArch}-${cpuArch}/bin/lefthook" "$@"
    elif test -f "$dir/node_modules/@evilmartians/lefthook/bin/lefthook-${osArch}-${cpuArch}/lefthook"
    then
      "$dir/node_modules/@evilmartians/lefthook/bin/lefthook-${osArch}-${cpuArch}/lefthook" "$@"
    elif test -f "$dir/node_modules/@evilmartians/lefthook-installer/bin/lefthook"
    then
      "$dir/node_modules/@evilmartians/lefthook-installer/bin/lefthook" "$@"
    elif test -f "$dir/node_modules/lefthook/bin/index.js"
    then
      "$dir/node_modules/lefthook/bin/index.js" "$@"
    elif go tool lefthook -h >/dev/null 2>&1
    then
      go tool lefthook "$@"
    elif bundle exec lefthook -h >/dev/null 2>&1
    then
      bundle exec lefthook "$@"
    elif yarn lefthook -h >/dev/null 2>&1
    then
      yarn lefthook "$@"
    elif pnpm lefthook -h >/dev/null 2>&1
    then
      pnpm lefthook "$@"
    elif swift package lefthook >/dev/null 2>&1
    then
      swift package --build-path .build/lefthook --disable-sandbox lefthook "$@"
    elif command -v mint >/dev/null 2>&1
    then
      mint run csjones/lefthook-plugin "$@"
    elif uv run lefthook -h >/dev/null 2>&1
    then
      uv run lefthook "$@"
    elif mise exec -- lefthook -h >/dev/null 2>&1
    then
      mise exec -- lefthook "$@"
    elif devbox run lefthook -h >/dev/null 2>&1
    then
      devbox run lefthook "$@"
    else
      echo "Can't find lefthook in PATH"
    fi
  fi
}

personal_repo()
{
  case "$(git remote get-url origin 2>/dev/null)" in
    *github.com:eirvandelden/* | *github.com/eirvandelden/*) return 0 ;;
  esac
  return 1
}

# The dotfiles repository and its worktrees keep their own lefthook.yml, as the shared config itself.
dotfiles_repo()
{
  _shared_dir="$(cd "${shared_config%/*}" 2>/dev/null && pwd -P)" || return 1
  _common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  _common_dir="$(cd "$_common_dir" 2>/dev/null && pwd -P)" || return 1
  test "$_common_dir" = "$_shared_dir/.git"
}

repo_config()
{
  _root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
  for _name in lefthook.yml .lefthook.yml .config/lefthook.yml
  do
    if test -f "$_root/$_name"
    then
      echo "$_root/$_name"
      return 0
    fi
  done
  return 1
}

# A single-quoted YAML scalar: a quote inside the path is doubled.
yaml_quote()
{
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"
}

use_runtime_config()
{
  runtime_dir="$(mktemp -d "${TMPDIR:-/tmp}/lefthook.XXXXXX")" || return 1
  trap 'rm -rf "$runtime_dir"' EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  _repo_config="$(repo_config)"
  {
    echo "extends:"
    # lefthook refuses a path listed twice, so a repo config that extends the shared config goes alone.
    if test -z "$_repo_config" || ! grep -qF "$shared_config" "$_repo_config"
    then
      echo "  - $(yaml_quote "$shared_config")"
    fi
    test -z "$_repo_config" || echo "  - $(yaml_quote "$_repo_config")"
  } > "$runtime_dir/lefthook.yml"
  export LEFTHOOK_CONFIG="$runtime_dir/lefthook.yml"
}

unset GIT_DIR

if personal_repo && test -f "$shared_config" && ! dotfiles_repo
then
  use_runtime_config || unset LEFTHOOK_CONFIG
else
  unset LEFTHOOK_CONFIG
fi

call_lefthook run "$hook" --no-auto-install "$@"
