#!/usr/bin/env ruby
# Fills a PR template from intent.md and plan.md before finish opens it, in
# either scope. A heading is matched by what it asks for, not by its exact
# wording, so any repository's own template phrasing still gets filled. A
# heading nothing matches, or whose body is a checkbox list, keeps its own
# text; a template where nothing matched — including no template at all —
# gets one "## Context" block prepended instead, built from the same four
# pieces.
CATEGORIES = [
  [ :summary, /summary|description|\A\s*what\s+(does|changed|is\s+this)\b/i ],
  [ :why, /why|motivation/i ],
  [ :test, /test|verify/i ],
  [ :implementation, /implementation|how|details/i ]
].freeze

TYPE_HEADING = /type/i
CHOICE_LIST = /^-\s*\[[ xX]\]/.freeze

HEADING = /^(#+\s+.*)$/.freeze
FENCE = /^(`{3,}|~{3,})/.freeze

def parse_sections(markdown)
  preamble = ""
  sections = []
  current = nil
  in_fence = false

  markdown.each_line do |line|
    in_fence = !in_fence if line.match?(FENCE)

    if !in_fence && line.match?(HEADING)
      current = { heading: line.chomp, title: line.sub(/^#+\s*/, "").strip, body: "\n" }
      sections << current
    elsif current
      current[:body] << line
    else
      preamble << line
    end
  end

  [ preamble, sections ]
end

def section_body(markdown, title)
  _preamble, sections = parse_sections(markdown)
  match = sections.find { |section| section[:title].casecmp?(title) }
  match && match[:body].strip
end

def joined(*parts)
  parts.compact.reject(&:empty?).join("\n\n")
end

def filler(intent, plan)
  {
    summary: joined(section_body(intent, "Problem"), section_body(intent, "Proposed outcome")),
    why: section_body(intent, "Problem") || "",
    implementation: joined(section_body(plan, "Files that change"), section_body(plan, "Order of work")),
    test: section_body(plan, "Proof") || ""
  }
end

def category_for(title)
  CATEGORIES.find do |name, pattern|
    next false if name == :summary && title.match?(TYPE_HEADING)

    title.match?(pattern)
  end&.first
end

def choice_list?(body)
  body.match?(CHOICE_LIST)
end

def context_block(fill)
  <<~MARKDOWN.strip
    ## Context

    **Summary**

    #{fill[:summary]}

    **Why**

    #{fill[:why]}

    **Implementation**

    #{fill[:implementation]}

    **Testing**

    #{fill[:test]}
  MARKDOWN
end

def heading_level(heading)
  heading[/^#+/].length
end

def category_for_section(section)
  choice_list?(section[:body]) ? nil : category_for(section[:title])
end

def fill_template(template, fill)
  preamble, sections = parse_sections(template)
  categories = sections.map { |section| category_for_section(section) }

  return joined(context_block(fill), template.strip) if categories.compact.empty?

  rebuilt = []
  absorbed_until_level = nil

  sections.zip(categories).each do |section, category|
    level = heading_level(section[:heading])
    next if absorbed_until_level && level > absorbed_until_level

    absorbed_until_level = nil

    if category
      rebuilt << "#{section[:heading]}\n\n#{fill[category]}\n\n"
      absorbed_until_level = level
    else
      rebuilt << "#{section[:heading]}#{section[:body]}"
    end
  end

  (preamble + rebuilt.join).strip
end

template_path, intent_path, plan_path = ARGV
unless intent_path && plan_path
  warn("usage: fill-pr-template <template-path-or-empty> <intent.md> <plan.md>")
  exit(1)
end

intent = File.read(intent_path)
plan = File.read(plan_path)
fill = filler(intent, plan)

template = template_path && !template_path.empty? && File.exist?(template_path) ? File.read(template_path) : ""

result = template.strip.empty? ? context_block(fill) : fill_template(template, fill)

puts(result)
