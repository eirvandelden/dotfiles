{
  "permissions": {
    "deny": [
      "Bash(mise:*)",
      "Bash(asdf:*)",
      "Bash(rbenv:*)",
      "Bash(rvm:*)",
      "Bash(chruby:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/master.key)",
      "Read(**/credentials.yml.enc)",
      "Read(**/credentials/*.key)"
    ],
    "ask": [
      "Bash(stow:*)",
      "Bash(brew uninstall:*)",
      "Bash(bundle update)",
      "Bash(*db:drop*)",
      "Bash(*db:reset*)",
      "Bash(*db:schema:load*)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/etienne.vandelden/.claude/hooks/herdr-claude-session-title.sh'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/etienne.vandelden/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/core-values.rb\" full",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/agent-voice.rb\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/consent-guard.rb\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/worktree-guard.rb\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/test-guard.rb\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/question-wording-guard.rb\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/markdown-hardwrap.rb\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/etienne.vandelden/.claude/hooks/herdr-claude-session-title.sh'",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/core-values.rb\" motto",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/etienne.vandelden/.claude/hooks/herdr-claude-session-title.sh'",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.rb"
  },
  "enabledPlugins": {
    "github@claude-plugins-official": false,
    "caveman@caveman": false,
    "agile@agile": false,
    "superpowers-ruby@superpowers-ruby": false,
    "ruby-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "aikido@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "agile": {
      "source": {
        "source": "github",
        "repo": "hubertlepicki/agile"
      }
    },
    "superpowers-ruby": {
      "source": {
        "source": "github",
        "repo": "lucianghinda/superpowers-ruby"
      }
    }
  },
  "sandbox": {
    "enabled": false,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "gem.coop",
        "rubygems.org",
        "registry.yarnpkg.com",
        "api.anthropic.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.local/share/rv",
        "~/.bundle",
        "~/.cache",
        "~/Library/Caches"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws/credentials",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
