{
  "model": "opus[1m]",
  "sandbox": {
    "enabled": true
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "headroom init hook ensure",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/etienne.vandelden/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/etienne.vandelden/.claude/hooks/herdr-claude-session-title.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "headroom init hook ensure",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/consent-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/etienne.vandelden/.claude/hooks/herdr-claude-session-title.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/etienne.vandelden/.claude/hooks/herdr-claude-session-title.sh'",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "caveman@caveman": true,
    "agile@agile": true,
    "superpowers-ruby@superpowers-ruby": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "agile": {
      "source": {
        "source": "github",
        "repo": "hubertlepicki/agile"
      }
    },
    "superpowers-ruby": {
      "source": {
        "source": "github",
        "repo": "lucianghinda/superpowers-ruby"
      }
    }
  },
  "effortLevel": "high",
  "theme": "dark-ansi",
  "spinnerVerbs": {
