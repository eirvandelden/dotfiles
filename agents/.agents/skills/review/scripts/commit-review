#!/usr/bin/env ruby
# Commits docs/changes/<slug>/review.md once the review has converged: it has a round and no open
# finding. An open round stays in the working tree, so one review leaves one commit however many
# rounds it takes. Exits 0 after committing or when there is nothing to commit, 1 otherwise. It
# never pushes; the caller pushes on exit 0.
require "open3"
require_relative "review_file"

SKILLS_DIR = File.expand_path("../..", __dir__)

def run(*command)
  stdout, stderr, status = Open3.capture3(*command)
  abort("#{command.first(3).join(' ')} failed: #{stderr.strip}") unless status.success?

  stdout
end

def refuse(lines)
  warn(lines)
  exit(1)
end

folder = run(File.join(SKILLS_DIR, "plan/scripts/change-folder")).strip
path = File.join(folder, "review.md")
refuse("No #{path}: run /review first.") unless File.exist?(path)

review = Review.new(File.read(path))
refuse("#{path} has no round: run /review first.") unless review.rounds?

open_findings = review.open_findings
refuse(open_findings.map { |line| "Open finding, close or dismiss it: #{line}" }) unless open_findings.empty?

if run("git", "status", "--porcelain", "--", path).empty?
  puts("Nothing to commit: #{path} is already committed.")
else
  run("git", "add", "--", path)
  run("git", "commit", "--quiet", "-m", "Review for #{File.basename(folder)}", "--", path)
  puts("Committed #{path}.")
end
