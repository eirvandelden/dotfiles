#!/usr/bin/env ruby
# Fills a PR template from intent.md and plan.md before deliver opens it, in
# either scope. A heading is matched by what it asks for, not by its exact
# wording, so any repository's own template phrasing still gets filled. A
# heading nothing matches, or whose body is a checkbox list, keeps its own
# text. A matched heading whose fill is empty keeps its own text too. Summary
# and Implementation, when no heading took them, are appended at the end under
# their own heading, with trimmed content. The body holds the intent's Problem
# and Proposed outcome, plus the plan's `## Design` subsections on
# DESIGN_SUBSECTIONS_IN_BODY, Mermaid fences included, so GitHub renders the
# diagrams after finish removes the change folder. Every other plan section
# (Signatures, Complexity, Invariants, Alternatives, Proof, Files that change)
# stays in plan.md.
CATEGORIES = [
  [ :summary, /\bsummary|\bdescription|\A\s*what\s+(does|changed|is\s+this)\b/i ],
  [ :why, /\bwhy|\bmotivation/i ],
  [ :test, /\btest|\bverify/i ],
  [ :implementation, /\bimplementation|\bhow|\bdetails/i ]
].freeze

APPEND_ORDER = [
  [ :summary, "Summary" ],
  [ :implementation, "Implementation" ]
].freeze

# The only Design subsections that reach the PR body.
DESIGN_SUBSECTIONS_IN_BODY = [ "Domain terms", "Diagrams" ].freeze

TYPE_HEADING = /type/i
CHOICE_LIST = /^-\s*\[[ xX]\]/.freeze

HEADING = /^(#+\s+.*)$/.freeze
FENCE = /^(`{3,}|~{3,})/.freeze

#: (String markdown) -> [String, Array[Hash[Symbol, String]]]
def parse_sections(markdown)
  preamble = ""
  sections = []
  current = nil
  in_fence = false

  markdown.each_line do |line|
    in_fence = !in_fence if line.match?(FENCE)

    if !in_fence && line.match?(HEADING)
      current = { heading: line.chomp, title: line.sub(/^#+\s*/, "").strip, body: "\n" }
      sections << current
    elsif current
      current[:body] << line
    else
      preamble << line
    end
  end

  [ preamble, sections ]
end

#: (String markdown, String title) -> String?
def section_body(markdown, title)
  _preamble, sections = parse_sections(markdown)
  match = sections.find { |section| section[:title].casecmp?(title) }
  match && match[:body].strip
end

# The allowlisted Design subsections with their deeper headings and fences, or "".
#: (String plan) -> String
def design_for_body(plan)
  _preamble, sections = parse_sections(plan)
  start = sections.index { |section| section[:title].casecmp?("Design") && heading_level(section[:heading]) == 2 }
  return "" unless start

  design = sections.drop(start + 1).take_while { |section| heading_level(section[:heading]) > 2 }
  joined(*allowed_subsections(design).map { |section| "#{section[:heading]}#{section[:body]}".strip })
end

#: (Array[Hash[Symbol, String]] design) -> Array[Hash[Symbol, String]]
def allowed_subsections(design)
  allowed = false
  design.select do |section|
    allowed = DESIGN_SUBSECTIONS_IN_BODY.any? { |title| title.casecmp?(section[:title]) } if heading_level(section[:heading]) == 3
    allowed
  end
end

#: (*String? parts) -> String
def joined(*parts)
  parts.compact.reject(&:empty?).join("\n\n")
end

#: (String intent) -> String
def summary_text(intent)
  joined(section_body(intent, "Problem"), section_body(intent, "Proposed outcome"))
end

#: (String intent, String plan) -> Hash[Symbol, String]
def filler(intent, plan)
  {
    summary: summary_text(intent),
    why: section_body(intent, "Problem") || "",
    implementation: design_for_body(plan)
  }
end

#: (String title) -> Symbol?
def category_for(title)
  CATEGORIES.find do |name, pattern|
    next false if name == :summary && title.match?(TYPE_HEADING)

    title.match?(pattern)
  end&.first
end

#: (String body) -> bool
def choice_list?(body)
  body.match?(CHOICE_LIST)
end

#: (Hash[Symbol, String] fill, Array[Symbol] filled_categories) -> String
def appended_sections(fill, filled_categories)
  APPEND_ORDER
    .reject { |category, _heading| filled_categories.include?(category) || fill[category].to_s.empty? }
    .map { |category, heading| "## #{heading}\n\n#{fill[category]}" }
    .join("\n\n")
end

#: (String heading) -> Integer
def heading_level(heading)
  heading[/^#+/].length
end

#: (Hash[Symbol, String] section) -> Symbol?
def category_for_section(section)
  choice_list?(section[:body]) ? nil : category_for(section[:title])
end

#: (String template, Hash[Symbol, String] fill) -> String
def fill_template(template, fill)
  preamble, sections = parse_sections(template)
  categories = sections.map { |section| category_for_section(section) }

  rebuilt = []
  filled_categories = []
  absorbed_until_level = nil
  keep_verbatim_until_level = nil

  sections.zip(categories).each do |section, category|
    level = heading_level(section[:heading])

    if keep_verbatim_until_level && level > keep_verbatim_until_level
      rebuilt << "#{section[:heading]}#{section[:body]}"
      next
    end
    keep_verbatim_until_level = nil

    if absorbed_until_level && level > absorbed_until_level
      if choice_list?(section[:body])
        keep_verbatim_until_level = absorbed_until_level
        rebuilt << "#{section[:heading]}#{section[:body]}"
      end
      next
    end
    absorbed_until_level = nil

    if category && !filled_categories.include?(category) && !fill[category].to_s.empty?
      rebuilt << "#{section[:heading]}\n\n#{fill[category]}\n\n"
      filled_categories << category
      absorbed_until_level = level
    else
      rebuilt << "#{section[:heading]}#{section[:body]}"
    end
  end

  body = (preamble + rebuilt.join).strip
  joined(body, appended_sections(fill, filled_categories))
end

template_path, intent_path, plan_path = ARGV
unless intent_path && plan_path
  warn("usage: fill-pr-template <template-path-or-empty> <intent.md> <plan.md>")
  exit(1)
end

intent = File.read(intent_path)
plan = File.read(plan_path)
fill = filler(intent, plan)

template = template_path && !template_path.empty? && File.exist?(template_path) ? File.read(template_path) : ""

puts(fill_template(template, fill))
