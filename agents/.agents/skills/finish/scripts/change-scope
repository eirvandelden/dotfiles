#!/usr/bin/env ruby
# Prints "personal" when the current repository's "origin" remote is under a
# personal owner, "work" when it matches an entry in RemoteMatcher's
# allowlist file, exits 1 otherwise. The finish skill uses this instead of
# guessing scope from the branch name or asking every time.
require_relative "change_scope"

scope = ChangeScope.current
if scope.nil?
  warn("unknown remote; finish refuses to guess.")
  exit(1)
end

puts(scope)
