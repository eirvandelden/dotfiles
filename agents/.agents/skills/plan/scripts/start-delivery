#!/usr/bin/env ruby
# Hands an accepted autonomous plan to a Claude coordinator. Run it with no arguments from inside
# the change's worktree. It refuses, and never starts Claude, unless origin is personal, plan.md
# is committed and unchanged, accepted with "Delivery: autonomous", and its critique is closed. It then runs the
# delivery preflight and refuses on any blocker. Inside Herdr the coordinator becomes a pane
# (hand-off-plan.sh deliver); outside Herdr it becomes a background session (claude --bg) that
# runs with the configured permission mode and every hook: no permission flag is ever passed.
require "open3"
require "tempfile"
require "time"
require_relative "../../../../../claude/.claude/hooks/remote_matcher"
require_relative "plan_critique"
require_relative "plan_metadata"

HERE = File.dirname(File.realpath(__FILE__))

#: (String message) -> bot
def refuse(message)
  warn(message)
  exit(1)
end

#: (*String arguments) -> [String, bool]
def git(*arguments)
  output, status = Open3.capture2e("git", *arguments)
  [ output.strip, status.success? ]
end

#: (*String arguments) -> String
def git!(*arguments)
  output, success = git(*arguments)
  refuse("git #{arguments.first} failed: #{output}") unless success
  output
end

#: -> String
def change_folder
  output, error, status = Open3.capture3(File.join(HERE, "change-folder"))
  refuse(error.strip) unless status.success?
  output.strip
end

#: -> void
def check_origin
  url, = git("remote", "get-url", "origin")
  return if RemoteMatcher.personal?(url)

  refuse("origin is not a personal repository: autonomous delivery runs only on personal origins.")
end

#: (String folder) -> String
def committed_plan(folder)
  path = "#{folder}/plan.md"
  _, committed = git("cat-file", "-e", "HEAD:#{path}")
  refuse("#{path} is not committed in HEAD: commit it first.") unless committed
  _, unchanged = git("diff", "--quiet", "HEAD", "--", path)
  refuse("#{path} has uncommitted changes: commit them first.") unless unchanged
  git!("show", "HEAD:#{path}")
end

#: (String text) -> void
def check_plan(text)
  refuse("plan.md is not accepted: Etienne has to accept the plan first.") unless PlanMetadata.accepted?(text)
  refuse("plan.md does not record Delivery: autonomous: this change is step-by-step.") unless PlanMetadata.autonomous?(text)

  problem = PlanCritique.problems(text).first
  refuse("plan.md critique is not closed: #{problem}.") if problem
end

#: -> void
def run_preflight
  path = ENV.fetch("DELIVERY_PREFLIGHT") { File.join(HERE, "delivery-preflight") }
  ran = system(path)
  refuse("The delivery preflight found blockers (or could not run): Claude was not started.") unless ran
end

#: -> bool
def inside_herdr?
  ENV["HERDR_ENV"] == "1" && !ENV.fetch("HERDR_PANE_ID", "").empty?
end

# hand-off-plan.sh deliver reuses only .worktrees/<slug> on branch <slug>.
#: (String slug) -> void
def check_branch_matches(slug)
  branch, = git("branch", "--show-current")
  return if branch == slug

  refuse("Inside Herdr the branch must equal the change slug, because hand-off-plan.sh deliver " \
         "reuses only .worktrees/#{slug} on branch #{slug}: the current branch is #{branch}.")
end

#: (String slug) -> bot
def hand_to_pane(slug)
  check_branch_matches(slug)
  scripts = ENV.fetch("HERDR_SCRIPTS_DIR") { File.expand_path("~/.config/herdr/scripts") }
  exec(File.join(scripts, "hand-off-plan.sh"), "deliver", slug)
end

#: (String slug, String worktree, String account) -> String
def coordinator_prompt(slug, worktree, account)
  <<~TEXT.gsub(/\s*\n\s*/, " ").strip
    You are the Claude coordinator of the autonomous delivery of docs/changes/#{slug} in #{worktree}.
    plan.md is accepted with Delivery: autonomous and its critique is closed.
    Read agents.md and CLAUDE.md first.
    Follow ~/.claude/skills/plan/references/autonomous-delivery.md from its preflight on.
    Run each stage's here backend in auto mode, in sequence, in this session.
    Keep #{account} current after every stage; never merge.
  TEXT
end

#: -> Float
def timeout_seconds
  Float(ENV.fetch("START_DELIVERY_TIMEOUT", "60"))
rescue ArgumentError
  60.0
end

#: (Integer pid) -> void
def kill_group(pid)
  Process.kill("KILL", -pid)
rescue Errno::ESRCH, Errno::EPERM
  nil
ensure
  Process.wait(pid)
end

# Waits for the child until the deadline. Returns its status, or nil after killing its group.
#: (Integer pid, Float seconds) -> Process::Status?
def wait_for(pid, seconds)
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + seconds
  loop do
    reaped, status = Process.wait2(pid, Process::WNOHANG)
    return status if reaped
    break if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

    sleep(0.05)
  end
  kill_group(pid)
  nil
end

# Output goes to a file, not a pipe: a background child holding a pipe open could block the read
# after claude ended.
#: (String slug, String worktree, String account) -> [String, bool]
def start_claude(slug, worktree, account)
  seconds = timeout_seconds
  Tempfile.create("start-delivery") do |capture|
    pid = Process.spawn("claude", "--bg", "--model", "opus", "--name", "deliver-#{slug}",
                        coordinator_prompt(slug, worktree, account),
                        chdir: worktree, in: File::NULL, out: capture, err: capture, pgroup: true)
    status = wait_for(pid, seconds)
    refuse("claude did not finish within #{format('%g', seconds)}s: Claude was not started.") unless status

    capture.rewind
    [ capture.read, status.success? ]
  end
rescue Errno::ENOENT
  refuse("claude is not on PATH: Claude was not started.")
end

SESSION_PATTERNS = [
  /claude attach ([0-9a-zA-Z-]{6,})/, /backgrounded\s*·\s*([0-9a-zA-Z-]{6,})/, /session[ :]+([0-9a-zA-Z-]{6,})/i
].freeze

#: (String output) -> String
def session_id(output)
  SESSION_PATTERNS.each do |pattern|
    id = output[pattern, 1]
    return id if id
  end
  "<session-id>"
end

#: (String worktree, String output, String account) -> String
def summary(worktree, output, account)
  id = session_id(output)
  <<~TEXT
    Delivery coordinator started at #{Time.now.iso8601}.
    Worktree: #{worktree}
    Claude said:
    #{output.strip}
    Attach: claude attach #{id}
    Logs: claude logs #{id}
    Stop: claude stop #{id}
    The account lands in #{account}
  TEXT
end

#: (String slug, String worktree, String herdr_directory) -> void
def hand_to_background(slug, worktree, herdr_directory)
  account = File.join(herdr_directory, "deliver-#{slug}.md")
  output, success = start_claude(slug, worktree, account)
  refuse("claude failed to start the coordinator:\n#{output}") unless success

  text = summary(worktree, output, account)
  File.write(File.join(herdr_directory, "deliver-#{slug}-handoff.md"), text)
  puts(text)
end

check_origin
folder = change_folder
check_plan(committed_plan(folder))
run_preflight
slug = File.basename(folder)
worktree = git!("rev-parse", "--show-toplevel")
inside_herdr? && hand_to_pane(slug)
herdr_directory = File.join(git!("rev-parse", "--path-format=absolute", "--git-common-dir"), "herdr")
Dir.mkdir(herdr_directory) unless Dir.exist?(herdr_directory)
hand_to_background(slug, worktree, herdr_directory)
