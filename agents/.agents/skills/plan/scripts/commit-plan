#!/usr/bin/env ruby
# Commits docs/changes/<slug>/plan.md once it says "Status: accepted". It stages that one path and
# commits only it, so work staged elsewhere stays out. An accepted plan that records
# "Delivery: autonomous" also needs a closed critique (PlanCritique). The subject is
# "docs: plan for <slug>". It never pushes; the caller pushes after it. On a work repository it
# commits nothing: the file stays local, and it warns when git does not ignore the change folder.
require "open3"
require_relative "../../finish/scripts/change_scope"
require_relative "plan_critique"
require_relative "plan_metadata"

CHANGE_FOLDER = File.expand_path("change-folder", __dir__)

#: (*String command) -> String
def run(*command)
  stdout, stderr, status = Open3.capture3(*command)
  abort("#{command.first(3).join(' ')} failed: #{stderr.strip}") unless status.success?

  stdout
end

#: (String message) -> bot
def refuse(message)
  warn(message)
  exit(1)
end

#: (String text) -> String?
def critique_problem(text)
  return nil unless PlanMetadata.autonomous?(text)

  PlanCritique.problems(text).first
end

folder = run(CHANGE_FOLDER).strip
plan = File.join(folder, "plan.md")
refuse("#{plan} does not exist: write the plan first (intent.md alone is not a plan).") unless File.file?(plan)

text = File.read(plan)
refuse("#{plan} is not accepted: accept the plan first.") unless PlanMetadata.accepted?(text)
problem = critique_problem(text)
refuse("#{plan} is autonomous but its critique is not closed: #{problem}.") if problem

slug = File.basename(folder)
if ChangeScope.work?
  warn("#{folder}/ is not ignored: add docs/changes to .git/info/exclude, or a git add . will stage it.") if ChangeScope.folder_visible?(folder)
  puts("Nothing committed: #{plan} stays local on a work repository.")
  exit(0)
end

subject = "docs: plan for #{slug}"
run("git", "add", "--", plan)
run("git", "commit", "--quiet", "-m", subject, "--", plan)
puts(subject)
