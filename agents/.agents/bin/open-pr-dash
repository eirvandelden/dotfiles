#!/bin/sh
# Runs the herdr-app open-pr-dash script. Needs a herdr-app terminal (HC_TERMINAL_ID).
# COORDINATOR=<address> becomes HERDR_APP_COORDINATOR.
if [ -n "${HC_TERMINAL_ID:-}" ]; then
  [ -z "${COORDINATOR:-}" ] || export HERDR_APP_COORDINATOR="$COORDINATOR"
  exec "${HERDR_APP_SCRIPTS_DIR:-$HOME/.config/herdr-app/scripts}/open-pr-dash.sh" "$@"
fi
echo "open-pr-dash: run it inside a herdr-app terminal (HC_TERMINAL_ID is unset)." >&2
exit 1
