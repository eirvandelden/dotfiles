#!/bin/sh
# Runs the herdr, herdr-app or Rex start-review script, chosen from the environment.
# HERDR_ENV=1 wins over HC_TERMINAL_ID, which wins over REX_SESSION.
# COORDINATOR=<id> becomes HERDR_PANE_ID, HERDR_APP_COORDINATOR or REX_BLOCK.
if [ "${HERDR_ENV:-}" = 1 ]; then
  [ -z "${COORDINATOR:-}" ] || export HERDR_PANE_ID="$COORDINATOR"
  exec "${HERDR_SCRIPTS_DIR:-$HOME/.config/herdr/scripts}/start-review.sh" "$@"
elif [ -n "${HC_TERMINAL_ID:-}" ]; then
  [ -z "${COORDINATOR:-}" ] || export HERDR_APP_COORDINATOR="$COORDINATOR"
  exec "${HERDR_APP_SCRIPTS_DIR:-$HOME/.config/herdr-app/scripts}/start-review.sh" "$@"
elif [ -n "${REX_SESSION:-}" ]; then
  [ -z "${COORDINATOR:-}" ] || export REX_BLOCK="$COORDINATOR"
  exec "${REX_SCRIPTS_DIR:-$HOME/.config/rex/scripts}/start-review.sh" "$@"
fi
echo "start-review: run it inside a herdr pane (HERDR_ENV=1), a herdr-app terminal (HC_TERMINAL_ID) or a Rex block (REX_SESSION)." >&2
exit 1
