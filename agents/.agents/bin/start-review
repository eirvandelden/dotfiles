#!/bin/sh
# Runs the herdr-app start-review script. Needs a herdr-app terminal (HC_TERMINAL_ID).
# COORDINATOR=<address> becomes HERDR_APP_COORDINATOR.
if [ -n "${HC_TERMINAL_ID:-}" ]; then
  [ -z "${COORDINATOR:-}" ] || export HERDR_APP_COORDINATOR="$COORDINATOR"
  exec "${HERDR_APP_SCRIPTS_DIR:-$HOME/.config/herdr-app/scripts}/start-review.sh" "$@"
fi
echo "start-review: run it inside a herdr-app terminal (HC_TERMINAL_ID is unset)." >&2
exit 1
